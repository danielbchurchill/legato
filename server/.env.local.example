# Copy to server/.env.local (gitignored via the root .gitignore's *.local
# pattern) and fill in real values. Every one of these is optional — an
# unset provider's two routes just 503 with a "not configured" message
# (server/src/routes/auth.ts), the same graceful-absence handling as
# ACOUSTID_API_KEY above it in config.ts. Nothing else in the app is gated
# by whether these are set.

# The public base URL this server is reachable at — used to build the
# redirect_uri both providers send the browser back to. For local
# development this is just the loopback address the server binds to.
AUTH_CALLBACK_BASE_URL=http://127.0.0.1:8899

# Google Cloud Console -> APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> Application type: Web application.
# Add this exact Authorized redirect URI:
#   http://127.0.0.1:8899/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
# Set the Authorization callback URL to exactly:
#   http://127.0.0.1:8899/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
