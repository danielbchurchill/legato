# Copy to relay/.env.local (gitignored via the root .gitignore's *.local
# pattern) and fill in real values. Every one of these is optional — an
# unset provider's two routes just 503 with a "not configured" message
# (relay/src/routes/auth.ts), the same graceful-absence handling
# server/.env.local.example documents for its own OAuth vars. Nothing
# else in this service is gated by whether a relay account is signed in.
#
# These are a SEPARATE OAuth app registration from server/'s — same
# providers, different callback URL, different client id/secret. Don't
# reuse server/'s GOOGLE_CLIENT_ID/GITHUB_CLIENT_ID here.

# The public base URL this relay is reachable at — used to build the
# redirect_uri both providers send the browser back to. For local
# development this is just the loopback address the relay binds to.
RELAY_AUTH_CALLBACK_BASE_URL=http://127.0.0.1:8901

# Google Cloud Console -> APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> Application type: Web application.
# Add this exact Authorized redirect URI:
#   http://127.0.0.1:8901/auth/google/callback
RELAY_GOOGLE_CLIENT_ID=
RELAY_GOOGLE_CLIENT_SECRET=

# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
# Set the Authorization callback URL to exactly:
#   http://127.0.0.1:8901/auth/github/callback
RELAY_GITHUB_CLIENT_ID=
RELAY_GITHUB_CLIENT_SECRET=

# Where the relay's SQLite database and WAL files live. Defaults to
# ~/.local/share/legato-relay if unset — only worth setting explicitly
# when deploying (e.g. to a container's persistent volume path; whatever
# sets that up is a separate workstream, not this one).
RELAY_DATA_DIR=
