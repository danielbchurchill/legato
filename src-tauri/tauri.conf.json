{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "legato",
  "version": "0.1.0",
  "identifier": "fm.legato.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run build:sidecar -- --if-missing && npm run dev",
    "beforeBuildCommand": "npm run build && npm run build:sidecar"
  },
  "app": {
    "windows": [
      {
        "title": "Legato",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#14181A"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["binaries/"],
    "externalBin": ["binaries/legato-server"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
