{
  "name": "legato",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "LEGATO_DATA_DIR=\"${LEGATO_DATA_DIR:-$HOME/.local/share/fm.legato.app}\" npm --prefix server run dev",
    "dev:full": "trap 'kill 0' EXIT INT TERM; npm run dev:server & npm run dev",
    "dev:remote": "trap 'kill 0' EXIT INT TERM; npm run dev:server & VITE_SERVER_HOST=\"$(tailscale ip -4)\" vite --host \"$(tailscale ip -4)\"",
    "dev:instance": "node scripts/tauri-dev-instance.mjs",
    "build": "tsc -b && vite build && node scripts/check-built-css.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "fetch:media-binaries": "node scripts/fetch-media-binaries.mjs",
    "build:sidecar": "node scripts/build-server-sidecar.mjs",
    "check:all": "npm --prefix server run typecheck && npm --prefix server test && npx vitest run && npm run build && npm run lint && npm run build:sidecar -- --if-missing && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource-variable/sometype-mono": "^5.3.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@sigma/node-image": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "d3-force": "^3.0.0",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sigma": "^3.0.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
