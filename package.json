{
  "name": "legato",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vite",
    "dev:server": "LEGATO_DATA_DIR=\"${LEGATO_DATA_DIR:-$HOME/.local/share/fm.legato.app}\" npm --prefix server run dev",
    "dev:full": "trap 'kill 0' EXIT INT TERM; npm run dev:server & npm run dev",
    "dev:remote": "trap 'kill 0' EXIT INT TERM; npm run dev:server & VITE_SERVER_HOST=\"$(tailscale ip -4)\" vite --host \"$(tailscale ip -4)\"",
    "airship": "airship --exec \"npm run dev:full\"",
    "airship:tauri": "airship --exec \"npx tauri dev --config src-tauri/tauri.airship.conf.json\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "fetch:media-binaries": "node scripts/fetch-media-binaries.mjs",
    "build:sidecar": "node scripts/build-server-sidecar.mjs",
    "check:all": "npm --prefix server test && npx vitest run && npm run build && npm run lint && npm run build:sidecar -- --if-missing && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource-variable/sometype-mono": "^5.3.0",
    "@sigma/node-image": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@wasm-audio-decoders/flac": "^0.2.10",
    "d3-force": "^3.0.0",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sigma": "^3.0.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@airshiplabs/cli": "^0.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
